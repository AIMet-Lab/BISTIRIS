        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://aimet-lab.github.io/BISTIRIS#curly"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Curly apron</rdfs:label>
    </owl:Class>
    


