    <!-- https://aimet-lab.github.io/BISTIRIS#Costume -->

    <owl:Class rdf:about="https://aimet-lab.github.io/BISTIRIS#Costume">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E22_Human-Made_Object"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P62i_is_depicted_by"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://schema.org/dateCreated"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#F-Costume"/>
            <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#M-Costume"/>
        </owl:disjointUnionOf>
        <rdfs:label xml:lang="en">Costume</rdfs:label>
    </owl:Class>
    


