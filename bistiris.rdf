                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#Garment"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P46i_forms_part_of"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
