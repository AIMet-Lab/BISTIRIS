<?xml version="1.0"?>
<rdf:RDF xmlns="https://aimet-lab.github.io/BISTIRIS#"
     xml:base="https://aimet-lab.github.io/BISTIRIS"
     xmlns:po="http://www.essepuntato.it/2008/12/pattern#"
     xmlns:aat="http://vocab.getty.edu/"
     xmlns:bst="https://aimet-lab.github.io/BISTIRIS#"
     xmlns:crm="http://www.cidoc-crm.org/cidoc-crm/"
     xmlns:dbo="http://dbpedia.org/ontology/"
     xmlns:dbp="http://dbpedia.org/property/"
     xmlns:dbr="http://dbpedia.org/resource/"
     xmlns:geo="http://www.w3.org/2003/01/geo/wgs84_pos#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:a-dd="https://w3id.org/arco/ontology/denotative-description/"
     xmlns:bibo="http://purl.org/ontology/bibo/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:yago="http://yago-knowledge.org/resource/"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:a-lite="https://w3id.org/arco/ontology/arco-lite/"
     xmlns:arkivo="http://purl.org/arkivo/ontology#"
     xmlns:schema="https://schema.org/"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://aimet-lab.github.io/BISTIRIS#">
        <owl:versionIRI rdf:resource="https://aimet-lab.github.io/BISTIRIS/bistiris.rdf"/>
        <dcterms:creator>G. Corona, D. Guidotti, L. Pandolfo, L. Pulina</dcterms:creator>
        <dcterms:description xml:lang="en">BISTIRIS is an ontology for analytically describing Sardinian traditional costumes.</dcterms:description>
        <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#float">2025.0</dcterms:issued>
        <rdfs:label xml:lang="en">BISTIRIS ontology</rdfs:label>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/issued -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- http://www.w3.org/2003/11/swrl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/11/swrl#isRuleEnabled"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://dbpedia.org/ontology/neighboringMunicipality -->

    <owl:ObjectProperty rdf:about="http://dbpedia.org/ontology/neighboringMunicipality">
        <owl:inverseOf rdf:resource="http://dbpedia.org/ontology/neighboringMunicipality"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://schema.org/Place"/>
        <rdfs:range rdf:resource="https://schema.org/Place"/>
        <rdfs:label xml:lang="en">neighboring municipality</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P46_is_composed_of -->

    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P46_is_composed_of">
        <owl:inverseOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P46i_forms_part_of"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="https://aimet-lab.github.io/BISTIRIS#Costume"/>
        <rdfs:range rdf:resource="https://aimet-lab.github.io/BISTIRIS#Garment"/>
        <rdfs:label xml:lang="en">P46 is composed of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P46i_forms_part_of -->

    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P46i_forms_part_of">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://aimet-lab.github.io/BISTIRIS#Garment"/>
        <rdfs:range rdf:resource="https://aimet-lab.github.io/BISTIRIS#Costume"/>
        <rdfs:label xml:lang="en">P46i forms part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P62i_is_depicted_by -->

    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P62i_is_depicted_by">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#Costume"/>
                    <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#Garment"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object"/>
        <rdfs:label xml:lang="en">P62i is depicted by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P89_falls_within -->

    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P89_falls_within">
        <rdfs:domain rdf:resource="https://schema.org/Place"/>
        <rdfs:range rdf:resource="http://yago-knowledge.org/resource/Provinces_of_Italy"/>
        <rdfs:label xml:lang="en">P89 falls within</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.essepuntato.it/2008/12/pattern#isContainedBy -->

    <owl:ObjectProperty rdf:about="http://www.essepuntato.it/2008/12/pattern#isContainedBy">
        <rdfs:domain rdf:resource="http://purl.org/spar/doco/Figure"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/ontology/bibo/Book"/>
                    <rdf:Description rdf:about="http://purl.org/ontology/bibo/Periodical"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:label xml:lang="en">is contained by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2002/07/owl#topObjectProperty -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2002/07/owl#topObjectProperty">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ReflexiveProperty"/>
        <rdfs:label xml:lang="en">topObjectProperty</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2004/02/skos/core#exactMatch -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#exactMatch">
        <owl:inverseOf rdf:resource="http://www.w3.org/2004/02/skos/core#exactMatch"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label xml:lang="en">exact match</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://aimet-lab.github.io/BISTIRIS#colourThroughTransparency -->

    <owl:ObjectProperty rdf:about="https://aimet-lab.github.io/BISTIRIS#colourThroughTransparency">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#F-Costume"/>
                    <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#F-Garment"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://dbpedia.org/ontology/Colour"/>
        <rdfs:label xml:lang="en">colour through transparency</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://aimet-lab.github.io/BISTIRIS#coveredBy -->

    <owl:ObjectProperty rdf:about="https://aimet-lab.github.io/BISTIRIS#coveredBy">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://aimet-lab.github.io/BISTIRIS#covers"/>
        <rdfs:domain rdf:resource="https://aimet-lab.github.io/BISTIRIS#Garment"/>
        <rdfs:range rdf:resource="https://aimet-lab.github.io/BISTIRIS#Garment"/>
        <rdfs:label xml:lang="en">covered by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://aimet-lab.github.io/BISTIRIS#coveredByTransparency -->

    <owl:ObjectProperty rdf:about="https://aimet-lab.github.io/BISTIRIS#coveredByTransparency">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://aimet-lab.github.io/BISTIRIS#coversWithTransparency"/>
        <rdfs:domain rdf:resource="https://aimet-lab.github.io/BISTIRIS#F-Garment"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#Curly_apron"/>
                    <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#Shoulder_veil"/>
                    <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#Veil"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:label xml:lang="en">covered by transparency</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://aimet-lab.github.io/BISTIRIS#coveredColour -->

    <owl:ObjectProperty rdf:about="https://aimet-lab.github.io/BISTIRIS#coveredColour">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://aimet-lab.github.io/BISTIRIS#Costume"/>
        <rdfs:range rdf:resource="http://dbpedia.org/ontology/Colour"/>
        <rdfs:label xml:lang="en">covered colour</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://aimet-lab.github.io/BISTIRIS#covers -->

    <owl:ObjectProperty rdf:about="https://aimet-lab.github.io/BISTIRIS#covers">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://aimet-lab.github.io/BISTIRIS#Garment"/>
        <rdfs:range rdf:resource="https://aimet-lab.github.io/BISTIRIS#Garment"/>
        <rdfs:label xml:lang="en">covers</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://aimet-lab.github.io/BISTIRIS#coversWithTransparency -->

    <owl:ObjectProperty rdf:about="https://aimet-lab.github.io/BISTIRIS#coversWithTransparency">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#Curly_apron"/>
                    <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#Shoulder_veil"/>
                    <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#Veil"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://aimet-lab.github.io/BISTIRIS#F-Garment"/>
        <rdfs:label xml:lang="en">covers with transparency</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://aimet-lab.github.io/BISTIRIS#sewn_togheter -->

    <owl:ObjectProperty rdf:about="https://aimet-lab.github.io/BISTIRIS#sewn_togheter">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://aimet-lab.github.io/BISTIRIS#sewn_togheter"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://aimet-lab.github.io/BISTIRIS#Garment"/>
        <rdfs:range rdf:resource="https://aimet-lab.github.io/BISTIRIS#Garment"/>
        <rdfs:label xml:lang="en">sewn togheter</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://schema.org/fromLocation -->

    <owl:ObjectProperty rdf:about="https://schema.org/fromLocation">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#Costume"/>
                    <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#Garment"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://schema.org/Place"/>
        <rdfs:comment>Traditional of</rdfs:comment>
        <rdfs:label xml:lang="en">from location</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/arco/ontology/arco-lite/hasColour -->

    <owl:ObjectProperty rdf:about="https://w3id.org/arco/ontology/arco-lite/hasColour">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#Costume"/>
                    <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#Garment"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://dbpedia.org/ontology/Colour"/>
        <rdfs:label xml:lang="en">has colour</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://dbpedia.org/ontology/elevation -->

    <owl:DatatypeProperty rdf:about="http://dbpedia.org/ontology/elevation">
        <rdfs:domain rdf:resource="https://schema.org/Place"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label xml:lang="en">elevation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://dbpedia.org/property/name -->

    <owl:DatatypeProperty rdf:about="http://dbpedia.org/property/name">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/title">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/ontology/bibo/Book"/>
                    <rdf:Description rdf:about="http://purl.org/ontology/bibo/Periodical"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:label xml:lang="en">title</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/2003/01/geo/wgs84_pos#lat -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/2003/01/geo/wgs84_pos#lat">
        <rdfs:domain rdf:resource="https://schema.org/Place"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label xml:lang="en">lat</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/2003/01/geo/wgs84_pos#long -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/2003/01/geo/wgs84_pos#long">
        <rdfs:domain rdf:resource="https://schema.org/Place"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label xml:lang="en">long</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://aimet-lab.github.io/BISTIRIS#BW -->

    <owl:DatatypeProperty rdf:about="https://aimet-lab.github.io/BISTIRIS#BW">
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="en">BW</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://aimet-lab.github.io/BISTIRIS#bow -->

    <owl:DatatypeProperty rdf:about="https://aimet-lab.github.io/BISTIRIS#bow">
        <rdfs:subPropertyOf rdf:resource="https://aimet-lab.github.io/BISTIRIS#technical_details"/>
        <rdfs:domain rdf:resource="https://aimet-lab.github.io/BISTIRIS#F-Garment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:label xml:lang="en">bow</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://aimet-lab.github.io/BISTIRIS#checkered_panel -->

    <owl:DatatypeProperty rdf:about="https://aimet-lab.github.io/BISTIRIS#checkered_panel">
        <rdfs:subPropertyOf rdf:resource="https://aimet-lab.github.io/BISTIRIS#skirt_panel"/>
        <rdfs:domain rdf:resource="https://aimet-lab.github.io/BISTIRIS#Long_skirt"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="en">checkered panel</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://aimet-lab.github.io/BISTIRIS#curly -->

    <owl:DatatypeProperty rdf:about="https://aimet-lab.github.io/BISTIRIS#curly">
        <rdfs:subPropertyOf rdf:resource="https://aimet-lab.github.io/BISTIRIS#technical_details"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#Curly_apron"/>
                    <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#Giacchino"/>
                    <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#Long_skirt"/>
                    <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#Skirt_trousers"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="en">curly</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://aimet-lab.github.io/BISTIRIS#drawing -->

    <owl:DatatypeProperty rdf:about="https://aimet-lab.github.io/BISTIRIS#drawing">
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="en">drawing</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://aimet-lab.github.io/BISTIRIS#embroideries -->

    <owl:DatatypeProperty rdf:about="https://aimet-lab.github.io/BISTIRIS#embroideries">
        <rdfs:subPropertyOf rdf:resource="https://aimet-lab.github.io/BISTIRIS#technical_details"/>
        <rdfs:domain rdf:resource="https://aimet-lab.github.io/BISTIRIS#Garment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:label xml:lang="en">embroideries</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://aimet-lab.github.io/BISTIRIS#flaps -->

    <owl:DatatypeProperty rdf:about="https://aimet-lab.github.io/BISTIRIS#flaps">
        <rdfs:subPropertyOf rdf:resource="https://aimet-lab.github.io/BISTIRIS#technical_details"/>
        <rdfs:domain rdf:resource="https://aimet-lab.github.io/BISTIRIS#F-Jacket"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="en">flaps</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://aimet-lab.github.io/BISTIRIS#floral_embroideries -->

    <owl:DatatypeProperty rdf:about="https://aimet-lab.github.io/BISTIRIS#floral_embroideries">
        <rdfs:subPropertyOf rdf:resource="https://aimet-lab.github.io/BISTIRIS#embroideries"/>
        <rdfs:domain rdf:resource="https://aimet-lab.github.io/BISTIRIS#F-Garment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:label xml:lang="en">floral embroideries</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://aimet-lab.github.io/BISTIRIS#fringes -->

    <owl:DatatypeProperty rdf:about="https://aimet-lab.github.io/BISTIRIS#fringes">
        <rdfs:subPropertyOf rdf:resource="https://aimet-lab.github.io/BISTIRIS#technical_details"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#Head_shawl"/>
                    <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#Shawl"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
