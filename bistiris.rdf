                        <owl:onProperty rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P46_is_composed_of"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="https://aimet-lab.github.io/BISTIRIS#Tube_trousers"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">M-Costume</rdfs:label>
    </owl:Class>
    


    <!-- https://aimet-lab.github.io/BISTIRIS#M-Garment -->

