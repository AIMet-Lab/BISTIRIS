            <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#M-Overgarment"/>
            <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#M-Shirt"/>
            <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#Neckerchief"/>
            <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#Trousers"/>
        </owl:disjointUnionOf>
