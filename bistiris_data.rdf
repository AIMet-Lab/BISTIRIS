    <!-- https://aimet-lab.github.io/BISTIRIS#Skirt_hat -->

    <owl:Class rdf:about="https://aimet-lab.github.io/BISTIRIS#Skirt_hat">
        <rdfs:subClassOf rdf:resource="https://aimet-lab.github.io/BISTIRIS#F-Headwear"/>
        <rdfs:label xml:lang="en">Skirt hat</rdfs:label>
    </owl:Class>
    


    <!-- https://aimet-lab.github.io/BISTIRIS#Skirt_trousers -->

    <owl:Class rdf:about="https://aimet-lab.github.io/BISTIRIS#Skirt_trousers">
        <rdfs:subClassOf rdf:resource="https://aimet-lab.github.io/BISTIRIS#M-Skirt"/>
        <rdfs:subClassOf rdf:resource="https://aimet-lab.github.io/BISTIRIS#Trousers"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://aimet-lab.github.io/BISTIRIS#curly"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Skirt trousers</rdfs:label>
    </owl:Class>
    


    <!-- https://aimet-lab.github.io/BISTIRIS#Tongue_shaped_apron -->

    <owl:Class rdf:about="https://aimet-lab.github.io/BISTIRIS#Tongue_shaped_apron">
        <rdfs:subClassOf rdf:resource="https://aimet-lab.github.io/BISTIRIS#Panel_apron"/>
        <owl:disjointWith rdf:resource="https://aimet-lab.github.io/BISTIRIS#Triangle_shaped_apron"/>
        <rdfs:label xml:lang="en">Tongue shaped apron</rdfs:label>
    </owl:Class>
    


    <!-- https://aimet-lab.github.io/BISTIRIS#Triangle_shaped_apron -->

    <owl:Class rdf:about="https://aimet-lab.github.io/BISTIRIS#Triangle_shaped_apron">
        <rdfs:subClassOf rdf:resource="https://aimet-lab.github.io/BISTIRIS#Panel_apron"/>
        <rdfs:label xml:lang="en">Triangle shaped apron</rdfs:label>
    </owl:Class>
    


    <!-- https://aimet-lab.github.io/BISTIRIS#Trousers -->

    <owl:Class rdf:about="https://aimet-lab.github.io/BISTIRIS#Trousers">
        <rdfs:subClassOf rdf:resource="https://aimet-lab.github.io/BISTIRIS#M-Garment"/>
        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#Bell-shaped_trousers"/>
            <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#Hose"/>
            <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#Loose_trousers"/>
            <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#Skirt_trousers"/>
            <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#Tube_trousers"/>
        </owl:disjointUnionOf>
        <rdfs:label xml:lang="en">Trousers</rdfs:label>
    </owl:Class>
    


    <!-- https://aimet-lab.github.io/BISTIRIS#Tube_trousers -->

    <owl:Class rdf:about="https://aimet-lab.github.io/BISTIRIS#Tube_trousers">
        <rdfs:subClassOf rdf:resource="https://aimet-lab.github.io/BISTIRIS#Trousers"/>
        <rdfs:label xml:lang="en">Tube trousers</rdfs:label>
    </owl:Class>
    


    <!-- https://aimet-lab.github.io/BISTIRIS#Veil -->

    <owl:Class rdf:about="https://aimet-lab.github.io/BISTIRIS#Veil">
        <rdfs:subClassOf rdf:resource="https://aimet-lab.github.io/BISTIRIS#F-Headwear"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://aimet-lab.github.io/BISTIRIS#coversWithTransparency"/>
                        <owl:someValuesFrom rdf:resource="https://aimet-lab.github.io/BISTIRIS#F-Garment"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://aimet-lab.github.io/BISTIRIS#coversWithTransparency"/>
                        <owl:allValuesFrom rdf:resource="https://aimet-lab.github.io/BISTIRIS#F-Garment"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/arco/ontology/arco-lite/hasColour"/>
                <owl:hasValue rdf:resource="http://dbpedia.org/resource/White"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Veil</rdfs:label>
    </owl:Class>
    


    <!-- https://aimet-lab.github.io/BISTIRIS#White_category -->

    <owl:Class rdf:about="https://aimet-lab.github.io/BISTIRIS#White_category">
        <rdfs:subClassOf rdf:resource="http://dbpedia.org/ontology/Colour"/>
        <rdfs:label xml:lang="en">White Category</rdfs:label>
    </owl:Class>
    


    <!-- https://aimet-lab.github.io/BISTIRIS#Yellow_category -->

    <owl:Class rdf:about="https://aimet-lab.github.io/BISTIRIS#Yellow_category">
        <rdfs:subClassOf rdf:resource="http://dbpedia.org/ontology/Colour"/>
        <rdfs:label xml:lang="en">Yellow Category</rdfs:label>
    </owl:Class>
    


