        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#Corset_belt"/>
            <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#F-Rigid_bodice"/>
            <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#F-Soft_bodice"/>
        </owl:disjointUnionOf>
        <rdfs:label xml:lang="en">F-Bodice</rdfs:label>
