    <!-- https://aimet-lab.github.io/BISTIRIS#Costume -->

    <owl:Class rdf:about="https://aimet-lab.github.io/BISTIRIS#Costume">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E22_Human-Made_Object"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P62i_is_depicted_by"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://schema.org/dateCreated"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#F-Costume"/>
            <rdf:Description rdf:about="https://aimet-lab.github.io/BISTIRIS#M-Costume"/>
        </owl:disjointUnionOf>
        <rdfs:label xml:lang="en">Costume</rdfs:label>
    </owl:Class>
    


    <!-- https://aimet-lab.github.io/BISTIRIS#Curly_apron -->

    <owl:Class rdf:about="https://aimet-lab.github.io/BISTIRIS#Curly_apron">
        <rdfs:subClassOf rdf:resource="https://aimet-lab.github.io/BISTIRIS#Apron"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://aimet-lab.github.io/BISTIRIS#curly"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Curly apron</rdfs:label>
    </owl:Class>
    


    <!-- https://aimet-lab.github.io/BISTIRIS#DVV -->

    <owl:Class rdf:about="https://aimet-lab.github.io/BISTIRIS#DVV">
        <rdfs:subClassOf rdf:resource="http://purl.org/arkivo/ontology#GlamThing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://schema.org/publisher"/>
                <owl:hasValue>Istituto Superiore Regionale Etnografico</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">DVV</rdfs:label>
    </owl:Class>
    


