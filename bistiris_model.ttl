###  https://aimet-lab.github.io/BISTIRIS#Trousers
bst:Trousers rdf:type owl:Class ;
             rdfs:subClassOf bst:M-Garment ;
             owl:disjointUnionOf ( bst:Bell-shaped_trousers
                                   bst:Hose
                                   bst:Loose_trousers
                                   bst:Skirt_trousers
                                   bst:Tube_trousers
                                 ) ;
             rdfs:label "Trousers"@en .


###  https://aimet-lab.github.io/BISTIRIS#Tube_trousers
bst:Tube_trousers rdf:type owl:Class ;
                  rdfs:subClassOf bst:Trousers ;
                  rdfs:label "Tube trousers"@en .


###  https://aimet-lab.github.io/BISTIRIS#Veil
bst:Veil rdf:type owl:Class ;
         rdfs:subClassOf bst:F-Headwear ,
                         [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                  owl:onProperty bst:coversWithTransparency ;
                                                  owl:someValuesFrom bst:F-Garment
                                                ]
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty bst:coversWithTransparency ;
                                                  owl:allValuesFrom bst:F-Garment
                                                ]
                                              ) ;
                           rdf:type owl:Class
                         ] ;
         rdfs:label "Veil"@en .


