@prefix : <https://aimet-lab.github.io/BISTIRIS#> .
@prefix po: <http://www.essepuntato.it/2008/12/pattern#> .
@prefix aat: <http://vocab.getty.edu/> .
@prefix bst: <https://aimet-lab.github.io/BISTIRIS#> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix dbp: <http://dbpedia.org/property/> .
@prefix dbr: <http://dbpedia.org/resource/> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix a-dd: <https://w3id.org/arco/ontology/denotative-description/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix yago: <http://yago-knowledge.org/resource/> .
@prefix swrla: <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .
@prefix a-lite: <https://w3id.org/arco/ontology/arco-lite/> .
@prefix arkivo: <http://purl.org/arkivo/ontology#> .
@prefix schema: <https://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://aimet-lab.github.io/BISTIRIS#> .

<https://aimet-lab.github.io/BISTIRIS#> rdf:type owl:Ontology ;
                                         owl:versionIRI <https://aimet-lab.github.io/BISTIRIS/bistiris.rdf> ;
                                         dcterms:creator "G. Corona, D. Guidotti, L. Pandolfo, L. Pulina" ;
                                         dcterms:description "BISTIRIS is an ontology for analytically describing Sardinian traditional costumes."@en ;
                                         dcterms:issued "2025.0"^^xsd:float ;
                                         rdfs:label "BISTIRIS ontology"@en ;
                                         owl:versionInfo 3.0 .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/creator
dcterms:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/issued
dcterms:issued rdf:type owl:AnnotationProperty .


###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
swrla:isRuleEnabled rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2003/11/swrl#isRuleEnabled
swrl:isRuleEnabled rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://dbpedia.org/ontology/neighboringMunicipality
dbo:neighboringMunicipality rdf:type owl:ObjectProperty ;
                            owl:inverseOf dbo:neighboringMunicipality ;
                            rdf:type owl:SymmetricProperty ;
                            rdfs:domain schema:Place ;
                            rdfs:range schema:Place ;
                            rdfs:label "neighboring municipality"@en .


###  http://www.cidoc-crm.org/cidoc-crm/P46_is_composed_of
crm:P46_is_composed_of rdf:type owl:ObjectProperty ;
                       owl:inverseOf crm:P46i_forms_part_of ;
                       rdf:type owl:InverseFunctionalProperty ;
                       rdfs:domain bst:Costume ;
                       rdfs:range bst:Garment ;
                       rdfs:label "P46 is composed of"@en .


###  http://www.cidoc-crm.org/cidoc-crm/P46i_forms_part_of
crm:P46i_forms_part_of rdf:type owl:ObjectProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain bst:Garment ;
                       rdfs:range bst:Costume ;
                       rdfs:label "P46i forms part of"@en .


###  http://www.cidoc-crm.org/cidoc-crm/P62i_is_depicted_by
crm:P62i_is_depicted_by rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf owl:topObjectProperty ;
                        rdf:type owl:FunctionalProperty ;
                        rdfs:domain [ rdf:type owl:Class ;
                                      owl:unionOf ( bst:Costume
                                                    bst:Garment
                                                  )
                                    ] ;
                        rdfs:range crm:E73_Information_Object ;
                        rdfs:label "P62i is depicted by"@en .


###  http://www.cidoc-crm.org/cidoc-crm/P89_falls_within
crm:P89_falls_within rdf:type owl:ObjectProperty ;
                     rdfs:domain schema:Place ;
                     rdfs:range yago:Provinces_of_Italy ;
                     rdfs:label "P89 falls within"@en .


###  http://www.essepuntato.it/2008/12/pattern#isContainedBy
po:isContainedBy rdf:type owl:ObjectProperty ;
                 rdfs:domain <http://purl.org/spar/doco/Figure> ;
                 rdfs:range [ rdf:type owl:Class ;
                              owl:unionOf ( bibo:Book
                                            bibo:Periodical
                                          )
                            ] ;
                 rdfs:label "is contained by"@en .


###  http://www.w3.org/2002/07/owl#topObjectProperty
owl:topObjectProperty rdf:type owl:ObjectProperty ,
                               owl:SymmetricProperty ,
                               owl:TransitiveProperty ,
                               owl:ReflexiveProperty ;
                      rdfs:label "topObjectProperty"@en .


###  http://www.w3.org/2004/02/skos/core#exactMatch
skos:exactMatch rdf:type owl:ObjectProperty ;
                owl:inverseOf skos:exactMatch ;
                rdf:type owl:SymmetricProperty ,
                         owl:TransitiveProperty ;
                rdfs:domain owl:Thing ;
                rdfs:range owl:Thing ;
                rdfs:label "exact match"@en .


###  https://aimet-lab.github.io/BISTIRIS#colourThroughTransparency
bst:colourThroughTransparency rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf owl:topObjectProperty ;
                              rdfs:domain [ rdf:type owl:Class ;
                                            owl:unionOf ( bst:F-Costume
                                                          bst:F-Garment
                                                        )
                                          ] ;
                              rdfs:range dbo:Colour ;
                              rdfs:label "colour through transparency"@en .


###  https://aimet-lab.github.io/BISTIRIS#coveredBy
bst:coveredBy rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf owl:topObjectProperty ;
              owl:inverseOf bst:covers ;
              rdfs:domain bst:Garment ;
              rdfs:range bst:Garment ;
              rdfs:label "covered by"@en .


###  https://aimet-lab.github.io/BISTIRIS#coveredByTransparency
bst:coveredByTransparency rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf owl:topObjectProperty ;
                          owl:inverseOf bst:coversWithTransparency ;
                          rdfs:domain bst:F-Garment ;
                          rdfs:range [ rdf:type owl:Class ;
                                       owl:unionOf ( bst:Curly_apron
                                                     bst:Shoulder_veil
                                                     bst:Veil
                                                   )
                                     ] ;
                          rdfs:label "covered by transparency"@en .


###  https://aimet-lab.github.io/BISTIRIS#coveredColour
bst:coveredColour rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf owl:topObjectProperty ;
                  rdfs:domain bst:Costume ;
                  rdfs:range dbo:Colour ;
                  rdfs:label "covered colour"@en .


###  https://aimet-lab.github.io/BISTIRIS#covers
bst:covers rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf owl:topObjectProperty ;
           rdfs:domain bst:Garment ;
           rdfs:range bst:Garment ;
           rdfs:label "covers"@en .


###  https://aimet-lab.github.io/BISTIRIS#coversWithTransparency
bst:coversWithTransparency rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf owl:topObjectProperty ;
                           rdfs:domain [ rdf:type owl:Class ;
                                         owl:unionOf ( bst:Curly_apron
                                                       bst:Shoulder_veil
                                                       bst:Veil
                                                     )
                                       ] ;
                           rdfs:range bst:F-Garment ;
                           rdfs:label "covers with transparency"@en .


###  https://aimet-lab.github.io/BISTIRIS#sewn_togheter
bst:sewn_togheter rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf owl:topObjectProperty ;
                  owl:inverseOf bst:sewn_togheter ;
                  rdf:type owl:SymmetricProperty ;
                  rdfs:domain bst:Garment ;
                  rdfs:range bst:Garment ;
                  rdfs:label "sewn togheter"@en .


###  https://schema.org/fromLocation
schema:fromLocation rdf:type owl:ObjectProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( bst:Costume
                                                bst:Garment
                                              )
                                ] ;
                    rdfs:range schema:Place ;
                    rdfs:comment "Traditional of" ;
                    rdfs:label "from location"@en .


###  https://w3id.org/arco/ontology/arco-lite/hasColour
a-lite:hasColour rdf:type owl:ObjectProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( bst:Costume
                                             bst:Garment
                                           )
                             ] ;
                 rdfs:range dbo:Colour ;
                 rdfs:label "has colour"@en .


#################################################################
#    Data properties
#################################################################

###  http://dbpedia.org/ontology/elevation
dbo:elevation rdf:type owl:DatatypeProperty ;
              rdfs:domain schema:Place ;
              rdfs:range xsd:float ;
              rdfs:label "elevation"@en .


###  http://dbpedia.org/property/name
dbp:name rdf:type owl:DatatypeProperty ;
         rdfs:domain owl:Thing ;
         rdfs:range xsd:string ;
         rdfs:label "name"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:DatatypeProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( bibo:Book
                                          bibo:Periodical
                                        )
                          ] ;
              rdfs:range rdfs:Literal ;
              rdfs:label "title"@en .


###  http://www.w3.org/2003/01/geo/wgs84_pos#lat
geo:lat rdf:type owl:DatatypeProperty ;
        rdfs:domain schema:Place ;
        rdfs:range xsd:float ;
        rdfs:label "lat"@en .


###  http://www.w3.org/2003/01/geo/wgs84_pos#long
geo:long rdf:type owl:DatatypeProperty ;
         rdfs:domain schema:Place ;
         rdfs:range xsd:float ;
         rdfs:label "long"@en .


###  https://aimet-lab.github.io/BISTIRIS#BW
bst:BW rdf:type owl:DatatypeProperty ;
       rdfs:domain crm:E73_Information_Object ;
       rdfs:range xsd:boolean ;
       rdfs:label "BW"@en .


###  https://aimet-lab.github.io/BISTIRIS#bow
bst:bow rdf:type owl:DatatypeProperty ;
        rdfs:subPropertyOf bst:technical_details ;
        rdfs:domain bst:F-Garment ;
        rdfs:range rdfs:Literal ;
        rdfs:label "bow"@en .


###  https://aimet-lab.github.io/BISTIRIS#checkered_panel
bst:checkered_panel rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf bst:skirt_panel ;
                    rdfs:domain bst:Long_skirt ;
                    rdfs:range xsd:boolean ;
                    rdfs:label "checkered panel"@en .


###  https://aimet-lab.github.io/BISTIRIS#curly
bst:curly rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf bst:technical_details ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( bst:Curly_apron
                                      bst:Giacchino
                                      bst:Long_skirt
                                      bst:Skirt_trousers
                                    )
                      ] ;
          rdfs:range xsd:boolean ;
          rdfs:label "curly"@en .


###  https://aimet-lab.github.io/BISTIRIS#drawing
bst:drawing rdf:type owl:DatatypeProperty ;
            rdfs:domain crm:E73_Information_Object ;
            rdfs:range xsd:boolean ;
            rdfs:label "drawing"@en .


###  https://aimet-lab.github.io/BISTIRIS#embroideries
bst:embroideries rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf bst:technical_details ;
                 rdfs:domain bst:Garment ;
                 rdfs:range rdfs:Literal ;
                 rdfs:label "embroideries"@en .


###  https://aimet-lab.github.io/BISTIRIS#flaps
bst:flaps rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf bst:technical_details ;
          rdfs:domain bst:F-Jacket ;
          rdfs:range xsd:boolean ;
          rdfs:label "flaps"@en .


###  https://aimet-lab.github.io/BISTIRIS#floral_embroideries
bst:floral_embroideries rdf:type owl:DatatypeProperty ;
                        rdfs:subPropertyOf bst:embroideries ;
                        rdfs:domain bst:F-Garment ;
                        rdfs:range rdfs:Literal ;
                        rdfs:label "floral embroideries"@en .


###  https://aimet-lab.github.io/BISTIRIS#fringes
bst:fringes rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf bst:technical_details ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( bst:Head_shawl
                                        bst:Shawl
                                      )
                        ] ;
            rdfs:range xsd:boolean ;
            rdfs:label "fringes"@en .


###  https://aimet-lab.github.io/BISTIRIS#intended_use
bst:intended_use rdf:type owl:DatatypeProperty ;
                 rdfs:domain bst:Costume ;
                 rdfs:range xsd:string ;
                 rdfs:label "intended use"@en .


###  https://aimet-lab.github.io/BISTIRIS#lace
bst:lace rdf:type owl:DatatypeProperty ;
         rdfs:subPropertyOf bst:technical_details ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( bst:Curly_apron
                                     bst:Giacchino
                                   )
                     ] ;
         rdfs:range xsd:boolean ;
         rdfs:label "lace"@en .


###  https://aimet-lab.github.io/BISTIRIS#màsculas
bst:màsculas rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf bst:technical_details ;
             rdfs:domain bst:Gheroni_skirt ;
             rdfs:range xsd:boolean ;
             rdfs:label "màsculas"@sc .


###  https://aimet-lab.github.io/BISTIRIS#open_slevees
bst:open_slevees rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf bst:technical_details ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( bst:F-Giubbetto
                                             bst:M-Giubbetto
                                           )
                             ] ;
                 rdfs:range xsd:boolean ;
                 rdfs:label "open slevees"@en .


###  https://aimet-lab.github.io/BISTIRIS#ornamental_buttons
bst:ornamental_buttons rdf:type owl:DatatypeProperty ;
                       rdfs:subPropertyOf bst:technical_details ;
                       rdfs:domain bst:Costume ;
                       rdfs:range xsd:boolean ;
                       rdfs:label "ornamental buttons"@en .


###  https://aimet-lab.github.io/BISTIRIS#panel_buttons
bst:panel_buttons rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf bst:skirt_panel ;
                  rdfs:domain bst:Long_skirt ;
                  rdfs:range xsd:boolean ;
                  rdfs:label "panel buttons"@en .


###  https://aimet-lab.github.io/BISTIRIS#pleating
bst:pleating rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf bst:technical_details ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( bst:Apron
                                         bst:F-Skirt
                                       )
                         ] ;
             rdfs:range xsd:boolean ;
             rdfs:label "pleating"@en .


###  https://aimet-lab.github.io/BISTIRIS#points
bst:points rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf bst:technical_details ;
           rdfs:domain bst:F-Bodice ;
           rdfs:range xsd:boolean ;
           rdfs:label "points"@en .


###  https://aimet-lab.github.io/BISTIRIS#skirt_panel
bst:skirt_panel rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf bst:technical_details ;
                rdfs:domain bst:Long_skirt ;
                rdfs:range xsd:boolean ;
                rdfs:label "skirt panel"@en .


###  https://aimet-lab.github.io/BISTIRIS#sleeve_buttonholes
bst:sleeve_buttonholes rdf:type owl:DatatypeProperty ;
                       rdfs:subPropertyOf bst:technical_details ;
                       rdfs:domain [ rdf:type owl:Class ;
                                     owl:unionOf ( bst:F-Jacket
                                                   bst:M-Jacket
                                                 )
                                   ] ;
                       rdfs:range xsd:boolean ;
                       rdfs:label "sleeve buttonholes"@en .


###  https://aimet-lab.github.io/BISTIRIS#sleeve_buttons
bst:sleeve_buttons rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf bst:technical_details ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( bst:F-Jacket
                                               bst:M-Jacket
                                             )
                               ] ;
                   rdfs:range xsd:boolean ;
                   rdfs:label "sleeve buttons"@en .


###  https://aimet-lab.github.io/BISTIRIS#sleeve_ribbon
bst:sleeve_ribbon rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf bst:technical_details ;
                  rdfs:domain bst:F-Jacket ;
                  rdfs:range rdfs:Literal ;
                  rdfs:label "sleeve ribbon"@en .


###  https://aimet-lab.github.io/BISTIRIS#striped_panel
bst:striped_panel rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf bst:skirt_panel ;
                  rdfs:domain bst:Long_skirt ;
                  rdfs:range xsd:boolean ;
                  rdfs:label "striped panel"@en .


###  https://aimet-lab.github.io/BISTIRIS#tassels
bst:tassels rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf bst:technical_details ;
            rdfs:domain bst:F-Headwear ;
            rdfs:range xsd:boolean ;
            rdfs:label "tassels"@en .


###  https://aimet-lab.github.io/BISTIRIS#technical_details
bst:technical_details rdf:type owl:DatatypeProperty ;
                      rdfs:domain bst:Garment ;
                      rdfs:label "technical details"@en .


###  https://aimet-lab.github.io/BISTIRIS#wrapping
bst:wrapping rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf bst:technical_details ;
             rdfs:domain bst:Panel_apron ;
             rdfs:range xsd:boolean ;
             rdfs:label "wrapping"@en .


###  https://schema.org/author
schema:author rdf:type owl:DatatypeProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( bibo:Book
                                          bibo:Periodical
                                        )
                          ] ;
              rdfs:range rdfs:Literal ;
              rdfs:label "author"@en .


###  https://schema.org/dateCreated
schema:dateCreated rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( bst:Costume
                                               bst:Garment
                                             )
                               ] ;
                   rdfs:range rdfs:Literal ;
                   rdfs:comment "Extended Date/Time Format (EDTF)." ;
                   rdfs:label "date created"@en .


###  https://schema.org/datePublished
schema:datePublished rdf:type owl:DatatypeProperty ;
                     rdfs:domain [ rdf:type owl:Class ;
                                   owl:unionOf ( bibo:Book
                                                 bibo:Periodical
                                               )
                                 ] ;
                     rdfs:range rdfs:Literal ;
                     rdfs:label "date published"@en .


###  https://schema.org/publisher
schema:publisher rdf:type owl:DatatypeProperty ;
                 rdfs:domain crm:E73_Information_Object ;
                 rdfs:range rdfs:Literal ;
                 rdfs:label "publisher"@en .


#################################################################
#    Classes
#################################################################

###  http://dbpedia.org/ontology/Colour
dbo:Colour rdf:type owl:Class ;
           rdfs:subClassOf a-dd:TechnicalCharacteristic ;
           rdfs:label "Colour"@en .


###  http://dbpedia.org/ontology/Place
dbo:Place rdf:type owl:Class ;
          rdfs:subClassOf schema:Place .


###  http://purl.org/arkivo/ontology#GlamThing
arkivo:GlamThing rdf:type owl:Class ;
                 rdfs:subClassOf crm:E73_Information_Object ;
                 rdfs:label "Glam Thing"@en .


###  http://purl.org/ontology/bibo/Book
bibo:Book rdf:type owl:Class ;
          rdfs:subClassOf crm:E73_Information_Object ;
          rdfs:label "Book"@en .


###  http://purl.org/ontology/bibo/Periodical
bibo:Periodical rdf:type owl:Class ;
                rdfs:subClassOf crm:E73_Information_Object ;
                rdfs:label "Periodical"@en .


###  http://purl.org/spar/doco/Figure
<http://purl.org/spar/doco/Figure> rdf:type owl:Class ;
                                   rdfs:subClassOf crm:E73_Information_Object ;
                                   rdfs:label "Figure"@en .


###  http://www.cidoc-crm.org/cidoc-crm/E22_Human-Made_Object
crm:E22_Human-Made_Object rdf:type owl:Class ;
                          rdfs:label "E22 Human-Made Object"@en .


###  http://www.cidoc-crm.org/cidoc-crm/E26_Physical_Feature
crm:E26_Physical_Feature rdf:type owl:Class ;
                         rdfs:label "E26 Physical Feature"@en .


###  http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object
crm:E73_Information_Object rdf:type owl:Class ;
                           rdfs:label "E73 Information Object"@en .


###  http://yago-knowledge.org/resource/Comune
yago:Comune rdf:type owl:Class ;
            rdfs:subClassOf schema:Place .


###  http://yago-knowledge.org/resource/Provinces_of_Italy
yago:Provinces_of_Italy rdf:type owl:Class ;
                        rdfs:subClassOf schema:Place ;
                        rdfs:label "Provinces of Italy"@en .


###  https://aimet-lab.github.io/BISTIRIS#Apron
bst:Apron rdf:type owl:Class ;
          rdfs:subClassOf bst:F-Garment ;
          owl:disjointUnionOf ( bst:Curly_apron
                                bst:Fan-shaped_apron
                                bst:Panel_apron
                              ) ;
          rdfs:label "Apron"@en .


###  https://aimet-lab.github.io/BISTIRIS#Bell-shaped_trousers
bst:Bell-shaped_trousers rdf:type owl:Class ;
                         rdfs:subClassOf bst:M-Skirt ,
                                         bst:Trousers ;
                         rdfs:label "Bell-shaped trousers"@en .


###  https://aimet-lab.github.io/BISTIRIS#Belt
bst:Belt rdf:type owl:Class ;
         rdfs:subClassOf bst:M-Garment ;
         rdfs:label "Belt"@en .


###  https://aimet-lab.github.io/BISTIRIS#Berritta
bst:Berritta rdf:type owl:Class ;
             rdfs:subClassOf bst:M-Headwear ;
             rdfs:label "Berritta"@sc .


###  https://aimet-lab.github.io/BISTIRIS#Black_category
bst:Black_category rdf:type owl:Class ;
                   rdfs:subClassOf dbo:Colour ;
                   rdfs:label "Black Category"@en .


###  https://aimet-lab.github.io/BISTIRIS#Blue_category
bst:Blue_category rdf:type owl:Class ;
                  rdfs:subClassOf dbo:Colour ;
                  rdfs:label "Blue Category"@en .


###  https://aimet-lab.github.io/BISTIRIS#Bolero
bst:Bolero rdf:type owl:Class ;
           rdfs:subClassOf bst:F-Jacket ;
           rdfs:label "Bolero"@en .


###  https://aimet-lab.github.io/BISTIRIS#Brimmed_hat
bst:Brimmed_hat rdf:type owl:Class ;
                rdfs:subClassOf bst:M-Headwear ;
                rdfs:label "Brimmed hat"@en .


###  https://aimet-lab.github.io/BISTIRIS#Brown_category
bst:Brown_category rdf:type owl:Class ;
                   rdfs:subClassOf dbo:Colour ;
                   rdfs:label "Brown Category"@en .


