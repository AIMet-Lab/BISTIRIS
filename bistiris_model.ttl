[ swrla:isRuleEnabled "true"^^xsd:boolean ;
   rdfs:comment "" ;
   rdfs:label "SourceRule" ;
   rdf:type swrl:Imp ;
   swrl:body [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                           swrl:propertyPredicate crm:P62i_is_depicted_by ;
                           swrl:argument1 <urn:swrl:var#costume> ;
                           swrl:argument2 <urn:swrl:var#place>
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                      swrl:propertyPredicate crm:P46_is_composed_of ;
                                      swrl:argument1 <urn:swrl:var#costume> ;
                                      swrl:argument2 <urn:swrl:var#garment>
                                    ] ;
                          rdf:rest rdf:nil
                        ]
             ] ;
   swrl:head [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
