###  https://aimet-lab.github.io/BISTIRIS#Shoulder_scarf
bst:Shoulder_scarf rdf:type owl:Class ;
                   rdfs:subClassOf bst:F-Overgarment ;
                   rdfs:label "Shoulder scarf"@en .


###  https://aimet-lab.github.io/BISTIRIS#Shoulder_veil
bst:Shoulder_veil rdf:type owl:Class ;
                  rdfs:subClassOf bst:F-Overgarment ,
                                  [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                           owl:onProperty bst:coversWithTransparency ;
                                                           owl:someValuesFrom bst:F-Garment
                                                         ]
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty bst:coversWithTransparency ;
                                                           owl:allValuesFrom bst:F-Garment
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
                  rdfs:label "Shoulder veil"@en .


###  https://aimet-lab.github.io/BISTIRIS#Skirt_hat
bst:Skirt_hat rdf:type owl:Class ;
              rdfs:subClassOf bst:F-Headwear ;
              rdfs:label "Skirt hat"@en .


###  https://aimet-lab.github.io/BISTIRIS#Skirt_trousers
bst:Skirt_trousers rdf:type owl:Class ;
                   rdfs:subClassOf bst:M-Skirt ,
                                   bst:Trousers ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty bst:curly ;
                                     owl:hasValue "true"^^xsd:boolean
                                   ] ;
                   rdfs:label "Skirt trousers"@en .


###  https://aimet-lab.github.io/BISTIRIS#Tongue_shaped_apron
bst:Tongue_shaped_apron rdf:type owl:Class ;
                        rdfs:subClassOf bst:Panel_apron ;
                        owl:disjointWith bst:Triangle_shaped_apron ;
                        rdfs:label "Tongue shaped apron"@en .


